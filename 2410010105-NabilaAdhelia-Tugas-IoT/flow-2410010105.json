    {
        "id": "56d4ed5eb0aef17c",
        "type": "function",
        "z": "419524edca16e188",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nvar th = flow.get('threshold');\nif (th === undefined || th === null) th = 35;\nvar alertMsg = null;\nif (data.suhu > th) {\n    alertMsg = {topic: 'iot/alert', payload: {pesan: 'Suhu melewati batas', suhu: data.suhu, batas: th, waktu: data.received}};\n}\nreturn [msg, alertMsg];",
        "outputs": 2,
        "x": 410,
        "y": 100,
        "wires": [
            [
                "db3c94b1615289d1"
            ],
            [
                "05f0caeba5dbedfe"
            ]
        ]
    },
