        "type": "function",
        "z": "419524edca16e188",
        "name": "Build Response Suhu",
        "func": "var key = msg.req.headers['x-api-key'];\nif (key !== 'iot-kampus-2410010105') {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nvar data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nvar th = flow.get('threshold');\nif (th === undefined || th === null) th = 35;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: th,\n    alert: (data.suhu !== null && data.suhu > th),\n    server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
