        "name": "Set Batas Suhu",
        "func": "var key = msg.req.headers['x-api-key'];\nif (key !== 'iot-kampus-2410010105') {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return msg;\n}\n\nvar b = msg.payload;\nif (!b || b.max === undefined || isNaN(Number(b.max))) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'field max (angka) wajib diisi'};\n    return msg;\n}\nflow.set('threshold', Number(b.max));\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', threshold: Number(b.max)};\nreturn msg;",
